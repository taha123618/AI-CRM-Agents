# ============================================================
# .env.example — Environment Variable Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file to Git.
# ============================================================


# ─── Database ─────────────────────────────────────────────
# For local development (non-Docker):
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/ai_crm

# For Docker Compose development — override this in docker-compose.dev.yml
# (already configured automatically — no change needed)
# DATABASE_URL=postgresql://crm_user:crm_password@db:5432/ai_crm


# ─── LLM API Keys ─────────────────────────────────────────
# Provide at least one of the following:
# LLM API Keys
OPENAI_API_KEY=k-ant-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022


# ─── Redis ────────────────────────────────────────────────
# For local development (non-Docker):
REDIS_URL=redis://localhost:6379/0

# For Docker Compose — overridden automatically in compose files
# REDIS_URL=redis://redis:6379/0


# ─── Application Settings ─────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-generate-a-secure-random-string-here
ALLOWED_HOSTS=localhost,127.0.0.1
# CORS: comma-separated list of allowed origins, or * to allow all (dev only)
ALLOWED_ORIGINS=*


# ─── Gunicorn (Production) ────────────────────────────────
# Number of worker processes (recommended: 2 * CPU cores + 1)
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120


# ─── Agent Feature Flags ──────────────────────────────────
LEAD_QUALIFICATION_ENABLED=true
EMAIL_INTELLIGENCE_ENABLED=true
SALES_PIPELINE_ENABLED=true
CUSTOMER_SUCCESS_ENABLED=true
MEETING_SCHEDULER_ENABLED=true
ANALYTICS_ENABLED=true


# ─── External Integrations ────────────────────────────────
GMAIL_API_CREDENTIALS=credentials/gmail_credentials.json
GOOGLE_CALENDAR_CREDENTIALS=credentials/calendar_credentials.json


# ─── Logging & Monitoring ─────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=


# ─── API Rate Limiting ────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
