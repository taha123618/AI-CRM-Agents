# ==============================================================================
# AI-Powered CRM - Field Sales Mobile App Environment Variables
# ==============================================================================

# Application Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Backend FastAPI Server Base URL
# - iOS Simulator: http://localhost:8000
# - Android Emulator: http://10.0.2.2:8000
# - Physical Device / Staging: http://<YOUR_LOCAL_IP>:8000 or https://api.aicrm.dev
EXPO_PUBLIC_API_URL=http://localhost:8000

# Real-Time WebSocket Endpoint
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws

# Enable offline fallback mock dataset when backend is unreachable
EXPO_PUBLIC_ENABLE_OFFLINE_MOCK=true
